# Create a token with Zone / Cache Purge permission for the target zone.
CLOUDFLARE_API_TOKEN=replace-with-your-cloudflare-api-token

# Find this on the target domain's Overview page in the Cloudflare dashboard.
CLOUDFLARE_ZONE_ID=replace-with-your-zone-id

# Generate a unique random value of at least 32 characters.
WEBHOOK_SECRET=replace-with-a-long-random-secret
